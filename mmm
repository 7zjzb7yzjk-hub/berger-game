<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,user-scalable=no">

<title>Burger Rush 🍔</title>

<style>

*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Tahoma,Arial,sans-serif;
    background:#130b08;
    color:white;
    min-height:100vh;
}

button{
    font:inherit;
    border:0;
    cursor:pointer;
}

.screen{
    display:none;
    min-height:100vh;
}

.active{
    display:flex;
}

/* ================= HOME ================= */

.home{
    align-items:center;
    justify-content:center;

    background:
    radial-gradient(
        circle at 50% 20%,
        #673719,
        #170b07 65%
    );
}

.card{
    background:#21130fee;
    border:1px solid #ffffff18;
    border-radius:28px;
    padding:28px;

    box-shadow:
    0 20px 70px #0008;
}

.home .card{
    text-align:center;
    width:min(650px,92%);
}

.logo{
    font-size:100px;

    filter:
    drop-shadow(
        0 15px 20px #000
    );

    animation:
    floating 2s infinite ease-in-out;
}

h1{
    font-size:
    clamp(34px,7vw,60px);

    color:#ffc14a;

    margin:5px 0;
}

.sub{
    color:#ddd;
    margin:10px 0 25px;
}

.btn{
    background:
    linear-gradient(
        135deg,
        #ffbd3b,
        #f36b20
    );

    color:white;

    border-radius:16px;

    padding:14px 24px;

    font-weight:bold;

    box-shadow:
    0 8px 22px #ff7b0038;

    margin:5px;

    transition:.2s;
}

.btn:hover{
    transform:
    translateY(-3px)
    scale(1.02);
}

.small{
    font-size:13px;
    color:#aaa;
}

/* ================= TOP ================= */

.game{
    flex-direction:column;
}

.top{
    display:flex;

    gap:8px;

    align-items:center;

    justify-content:space-between;

    padding:10px 14px;

    background:#190d09ee;

    position:sticky;

    top:0;

    z-index:20;

    flex-wrap:wrap;
}

.stat{
    background:#ffffff0d;

    border-radius:13px;

    padding:8px 12px;

    text-align:center;
}

.stat b{
    color:#ffc14a;
}

.back{
    background:#ffffff12;

    color:#fff;

    padding:10px 14px;

    border-radius:12px;
}

/* ================= GAME ================= */

.wrap{
    width:min(1250px,95%);

    margin:auto;

    padding:16px 0 35px;
}

.layout{
    display:grid;

    grid-template-columns:
    330px 1fr;

    gap:16px;
}

.panel{
    background:#21130fe8;

    border:1px solid #ffffff12;

    border-radius:22px;

    padding:16px;

    box-shadow:
    0 15px 40px #0005;
}

.panel h2,
.panel h3{
    margin:0 0 12px;

    color:#ffc14a;
}

.orderbox{
    position:sticky;
    top:75px;
}

.customer{
    font-size:58px;
    text-align:center;

    animation:
    customerMove 3s infinite;
}

.bubble{
    background:white;

    color:#24130d;

    border-radius:18px;

    padding:12px;

    position:relative;

    margin-bottom:12px;
}

.bubble:after{
    content:"";

    position:absolute;

    bottom:-10px;

    right:35px;

    border:10px solid transparent;

    border-top-color:white;

    border-bottom:0;
}

.order-items{
    display:flex;

    flex-wrap:wrap;

    gap:6px;
}

.tag{
    background:#ffffff12;

    padding:7px 9px;

    border-radius:10px;
}

.meter{
    height:12px;

    background:#ffffff12;

    border-radius:99px;

    overflow:hidden;

    margin:8px 0;
}

.meter>div{
    height:100%;

    width:100%;

    background:#4dde76;

    transition:.2s;
}

/* ================= KITCHEN ================= */

.kitchen{
    display:grid;

    grid-template-columns:
    1fr 1fr;

    gap:16px;
}

.station{
    min-height:270px;
}

/* ================= GRILL ================= */

.grill{
    height:160px;

    border-radius:18px;

    background:
    repeating-linear-gradient(
        0deg,
        #151515 0 11px,
        #333 12px 17px
    );

    display:flex;

    align-items:center;

    justify-content:center;

    position:relative;

    overflow:hidden;
}

.flame{
    position:absolute;

    bottom:5px;

    font-size:42px;

    animation:
    flame .35s infinite alternate;
}

.patty{
    width:125px;

    height:65px;

    border-radius:50%;

    background:
    linear-gradient(
        #7d351e,
        #42160d
    );

    box-shadow:
    inset 0 -9px #2c0e08;

    display:none;

    z-index:2;
}

.patty.show{
    display:block;
}

.patty.raw{
    background:#9b4728;
}

.patty.good{
    background:#562014;
}

.patty.burn{
    background:#111;
}

.controls{
    display:flex;

    gap:6px;

    margin-top:8px;
}

.controls button,
.ingredient{
    flex:1;

    background:#ffffff10;

    color:#fff;

    border-radius:12px;

    padding:10px;

    transition:.15s;
}

.controls button:hover,
.ingredient:hover{
    background:#ffffff20;

    transform:
    translateY(-2px);
}

.heat{
    height:9px;

    background:#ffffff12;

    border-radius:20px;

    margin-top:8px;

    overflow:hidden;
}

.heat div{
    height:100%;

    width:0;

    background:
    linear-gradient(
        90deg,
        #4de477,
        #ffd447,
        #ff4b30
    );

    transition:.15s;
}

/* ================= INGREDIENTS ================= */

.ingredients{
    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    gap:8px;
}

.ingredient{
    min-height:75px;
}

.ingredient span{
    display:block;

    font-size:28px;

    margin-bottom:4px;
}

.ingredient:active{
    transform:scale(.94);
}

/* ================= BURGER ================= */

.build{
    min-height:260px;

    background:#160c08;

    border-radius:18px;

    display:flex;

    flex-direction:column;

    justify-content:flex-end;

    align-items:center;

    padding:20px;

    overflow:hidden;
}

.layer{
    width:min(280px,80%);

    height:28px;

    margin-top:-4px;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:20px;

    animation:
    drop .25s;
}

.bun{
    background:
    linear-gradient(
        #f0b24e,
        #ad6323
    );

    height:45px;

    border-radius:
    90px 90px
    12px 12px;
}

.meat{
    background:
    linear-gradient(
        #682a18,
        #32100a
    );

    border-radius:12px;
}

.cheese{
    background:#ffc928;

    height:17px;
}

.lettuce{
    background:#55a83d;

    border-radius:20px;
}

.tomato{
    background:#d9382c;

    border-radius:15px;
}

.onion{
    background:#a85aa5;

    border-radius:20px;
}

.sauce{
    background:#b53b19;

    height:10px;

    border-radius:20px;
}

.actions{
    display:flex;

    gap:8px;

    margin-top:10px;
}

.wide{
    width:100%;
}

/* ================= FRIES ================= */

.fries{
    height:160px;

    background:#b9471f;

    border-radius:
    12px 12px
    25px 25px;

    display:flex;

    align-items:flex-start;

    justify-content:center;

    padding-top:12px;
}

.fries:before{
    content:"🍟🍟🍟🍟🍟";

    font-size:35px;

    letter-spacing:-8px;
}

.drink{
    height:160px;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:100px;
}

/* ================= RESULT ================= */

.result{
    align-items:center;

    justify-content:center;

    background:
    radial-gradient(
        circle,
        #3d2112,
        #100705
    );
}

.result .card{
    text-align:center;

    width:min(560px,92%);
}

.stars{
    font-size:38px;

    margin:12px;
}

.big{
    font-size:70px;
}

/* ================= SHOP ================= */

.shop{
    width:min(850px,92%);

    margin:auto;

    padding:30px 0;
}

.upgrade{
    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:10px;

    padding:15px;

    margin:10px 0;

    background:#ffffff0b;

    border-radius:15px;
}

/* ================= SOUND PANEL ================= */

.sound-panel{
    position:fixed;

    left:15px;

    bottom:15px;

    z-index:999;

    background:#21130fee;

    border:1px solid #ffffff20;

    border-radius:18px;

    padding:10px;

    box-shadow:
    0 10px 30px #0008;

    display:flex;

    align-items:center;

    gap:8px;
}

.sound-button{
    background:#ffffff12;

    color:white;

    border:0;

    border-radius:12px;

    padding:9px 12px;

    cursor:pointer;

    font-size:20px;
}

.volume{
    width:90px;
}

/* ================= ANIMATIONS ================= */

@keyframes flame{

    from{
        transform:
        scale(.9)
        rotate(-3deg);
    }

    to{
        transform:
        scale(1.1)
        rotate(3deg);
    }
}

@keyframes drop{

    from{
        transform:
        translateY(-30px);

        opacity:0;
    }

    to{
        transform:none;

        opacity:1;
    }
}

@keyframes floating{

    0%,100%{
        transform:
        translateY(0);
    }

    50%{
        transform:
        translateY(-10px);
    }
}

@keyframes customerMove{

    0%,100%{
        transform:scale(1);
    }

    50%{
        transform:scale(1.04);
    }
}

/* ================= MOBILE ================= */

@media(max-width:850px){

    .layout,
    .kitchen{
        grid-template-columns:1fr;
    }

    .orderbox{
        position:static;
    }

    .top{
        justify-content:center;
    }

    .ingredients{
        grid-template-columns:
        repeat(4,1fr);
    }

}

@media(max-width:520px){

    .ingredients{
        grid-template-columns:
        repeat(3,1fr);
    }

    .wrap{
        width:96%;
    }

    .panel{
        padding:12px;
    }

    .sound-panel{
        left:8px;
        bottom:8px;
    }

}

</style>
</head>

