function startMusic(){

    if(!soundEnabled){

        return;

    }


    if(musicTimer){

        return;

    }


    initAudio();


    const melody = [

        261.63,
        329.63,
        392.00,
        329.63,

        293.66,
        349.23,
        440.00,
        349.23

    ];


    let index = 0;


    musicTimer =
    setInterval(
        function(){

            if(!soundEnabled){

                return;

            }


            tone(
                melody[index],
                0.35,
                "sine",
                0.025
            );


            index++;


            if(
                index >=
                melody.length
            ){

                index = 0;

            }

        },
        450
    );

}


function stopMusic(){

    if(musicTimer){

        clearInterval(
            musicTimer
