/* =====================================================
   RENDER BURGER
===================================================== */

function renderBurger(){

    let burger =
    $("burger");


    burger.innerHTML =
    "";


    const layers =
    built.filter(
        function(x){

            return (
                x !== "fries" &&
                x !== "drink"
            );

        }
    );


    layers.forEach(
        function(x){

            let d =
            document.createElement(
                "div"
            );


            d.className =
            "layer " + x;


            d.textContent =
            E[x];


            burger.appendChild(
                d
            );

        }
    );


    if(
        !layers.length
    ){

        burger.innerHTML =
        `
        <span class="small">
        ضعي الخبز والمكونات هنا 👇
        </span>
        `;

    }


    $("buildText").textContent =
    built.length
    ?
    built
    .map(
        function(x){

            return E[x] +
            " " +
            N[x];

        }
    )
    .join(" ← ")
    :
    "ابدئي بالخبز ثم رتبي المكونات.";

}


/* =====================================================
   CLEAR
===================================================== */

function clearBurger(){

    built = [];

    renderBurger();

}


/* =====================================================
   SERVE
===================================================== */

function serve(){

    if(
        !built.length
    ){

        alert(
            "الطلب ما اكتمل 😭"
        );

        return;

    }


    clearInterval(
        timer
    );


    let missing =
    order.filter(
        function(x){

            return !built.includes(x);

        }
    );


    let extra =
    built.filter(
        function(x){

            return !order.includes(x);

        }
    );


    let correct =
    order.length -
    missing.length;


    let accuracy =
    Math.max(
        0,
        Math.round(
            correct /
            order.length *
            100
        )
    );


    accuracy -=
    extra.length * 8;


    accuracy =
    Math.max(
        0,
        accuracy
    );


    let cookedBonus =
    (
        cook >=45 &&
        cook <82
    )
    ?
    15
    :
    0;


    let speedBonus =
    Math.floor(
        timeLeft/2
    );


    let satBonus =
    Math.floor(
        satisfaction/5
    );


    let chefBonus =
    upgrades.chef*8;


    let points =
    Math.max(
        0,
        accuracy +
        speedBonus +
        cookedBonus +
        satBonus +
        chefBonus
    );


    let perfect =
    missing.length === 0 &&
    extra.length === 0 &&
    accuracy >=95;


    if(perfect){

        combo++;


        points +=
        combo*10;


        money +=
        20 +
        upgrades.chef*5;


        if(
            level <20
        ){

            level++;

        }

    }else{

        combo = 0;


        money +=
        Math.max(
            5,
            Math.floor(
                points/4
            )
        );

    }


    score += points;


    save();


    /* الصوت */

    if(perfect){

        soundPerfect();

    }else if(
        points >=65
    ){

        soundSuccess();

    }else{

        soundFail();

    }


    /* النجوم */

    let stars;


    if(
        points >=120
    ){

        stars =
        "⭐⭐⭐⭐⭐";

    }else if(
        points >=90
    ){

        stars =
        "⭐⭐⭐⭐";

    }else if(
        points >=65
    ){

        stars =
        "⭐⭐⭐";

    }else if(
        points >=35
    ){

        stars =
        "⭐⭐";

    }else{

        stars =
        "⭐";

    }


    $("stars").textContent =
    stars;


    $("resultPoints").textContent =
    "+" +
    points +
    " نقطة";


    if(perfect){

        $("resultTitle").textContent =
        "🔥 طلب مثالي!";


        $("resultText").textContent =
        "الزبون مبسوط جدًا وترك بقشيش! 💰";


        $("resultEmoji").textContent =
        "🤩";

    }else if(
        points >=65
    ){

        $("resultTitle").textContent =
        "😋 طلب جيد";


        $("resultText").textContent =
        "الزبون أعجبه البرجر!";


        $("resultEmoji").textContent =
        "😋";

    }else{

        $("resultTitle").textContent =
        "🥲 نحتاج تدريب أكثر";


        if(
            missing.length
        ){

            $("resultText").textContent =
            "ناقص: " +
            missing
            .map(
                function(x){

                    return N[x];

                }
            )
            .join("، ");

        }else{

            $("resultText").textContent =
            "فيه مكونات زيادة أو ترتيب غير صحيح.";

        }


        $("resultEmoji").textContent =
        "😅";

    }


    show("result");

}


