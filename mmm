/* =====================================================
   MAKE ORDER
===================================================== */

function makeOrder(){

    clearInterval(timer);

    clearBurger();


    pattyOn = false;

    cook = 0;

    cooking = false;


    let max =
    Math.min(
        orders.length,
        2 +
        Math.floor(level/2) +
        upgrades.recipe
    );


    order =
    orders[
        Math.floor(
            Math.random()*max
        )
    ].slice();


    $("customer").textContent =
    customers[
        Math.floor(
            Math.random() *
            customers.length
        )
    ];


    $("orderItems").innerHTML =
    order
    .map(
        function(x){

            return `
            <span class="tag">
            ${E[x]} ${N[x]}
            </span>
            `;

        }
    )
    .join("");


    timeLeft =
    60 +
    upgrades.time*8 +
    Math.min(
        level*2,
        20
    );


    satisfaction = 100;


    $("time").textContent =
    timeLeft;


    $("satisfaction").textContent =
    100;


    $("satisfactionBar").style.width =
    "100%";


    $("timeBar").style.width =
    "100%";


    $("speech").textContent =
    "أبي " +
    order
    .map(
        function(x){

            return N[x];

        }
    )
    .join(" + ") +
    " 😋";


    timer =
    setInterval(
        function(){

            timeLeft--;


            if(
                timeLeft <= 10 &&
                timeLeft > 0
            ){

                soundWarning();

            }


            if(
                timeLeft % 3 === 0
            ){

                satisfaction =
                Math.max(
                    0,
                    satisfaction-1
                );

            }


            $("time").textContent =
            timeLeft;


            $("satisfaction").textContent =
            satisfaction;


            $("satisfactionBar")
            .style.width =
            satisfaction+"%";


            $("timeBar")
            .style.width =
            (
                timeLeft /
                (
                    60 +
                    upgrades.time*8 +
                    Math.min(
                        level*2,
                        20
                    )
                )
                *100
            )+"%";


            if(
                timeLeft <= 0
            ){

                fail();

            }

        },
        1000
    );

}


