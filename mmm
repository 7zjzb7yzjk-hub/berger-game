]

];


/* =====================================================
   GAME VARIABLES
===================================================== */

let score =
Number(
localStorage.getItem("score")
) || 0;


let money =
Number(
localStorage.getItem("money")
) || 100;


let level =
Number(
localStorage.getItem("level")
) || 1;


let combo = 0;


let upgrades =
JSON.parse(
localStorage.getItem("upgrades") ||
'{"grill":0,"time":0,"chef":0,"recipe":0}'
);


let order = [];

let built = [];

let timeLeft = 60;

let satisfaction = 100;

let pattyOn = false;

let cook = 0;

let cooking = false;

let timer = null;

let cookTimer = null;


/* =====================================================
   AUDIO SYSTEM
===================================================== */

let audioContext = null;

let masterVolume =
Number(
localStorage.getItem("volume")
) || 0.6;


let soundEnabled =
localStorage.getItem("soundEnabled")
!== "false";


let musicTimer = null;


/* إنشاء الصوت */

function initAudio(){

    if(!audioContext){

        audioContext =
        new(
            window.AudioContext ||
            window.webkitAudioContext
        )();

    }

    if(
        audioContext.state ===
        "suspended"
    ){

        audioContext.resume();

    }

}


/* نغمة */

function tone(
    frequency,
    duration=0.12,
    type="sine",
    volume=0.2
){

    if(!soundEnabled){

        return;

    }

    initAudio();

    const oscillator =
    audioContext.createOscillator();

    const gain =
    audioContext.createGain();


    oscillator.type =
    type;


    oscillator.frequency.value =
    frequency;


    gain.gain.setValueAtTime(
        0,
        audioContext.currentTime
    );


    gain.gain.linearRampToValueAtTime(
        volume * masterVolume,
        audioContext.currentTime + 0.01
    );


    gain.gain.exponentialRampToValueAtTime(
        0.001,
        audioContext.currentTime +
        duration
    );


    oscillator.connect(gain);

    gain.connect(
        audioContext.destination
    );


    oscillator.start();


    oscillator.stop(
        audioContext.currentTime +
        duration
    );

}


